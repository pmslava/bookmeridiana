# Cloudflare Pages response headers.
# Pages defaults JS/CSS to Cache-Control max-age=14400 (4h), which pins stale
# code after a deploy. Filenames aren't content-hashed, so make code + data
# always revalidate (cheap 304 via ETag) — deploys then reach everyone at once.
# NB: a bare `/*` catch-all does NOT override Pages' default Cache-Control;
# extension-specific rules do. So we list them explicitly.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.json
  Cache-Control: public, max-age=0, must-revalidate

# Images never change — cache a week.
/*.png
  Cache-Control: public, max-age=604800
